# Hired AI / Maya commercial environment
NODE_ENV=production
APP_URL=https://your-domain.example
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Stripe — never commit real values.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CAREER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_CONCIERGE=price_...

# Optional natural-language layer. Deterministic Maya still works without it.
OPENAI_API_KEY=
HIRED_MAYA_MODEL=gpt-5.6-luna
HIRED_MAYA_MAX_OUTPUT_TOKENS=600

# Job discovery sources that you are authorized to consume.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
JOB_JSON_FEEDS=

# Runtime limits
HIRED_AUTH_RATE_LIMIT=12
HIRED_API_RATE_LIMIT=180
HIRED_DB_POOL_MAX=12
HIRED_CHECKPOINT_MS=5000
