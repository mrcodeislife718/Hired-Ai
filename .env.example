# Hired AI commercial environment
NODE_ENV=production
APP_URL=https://your-domain.example
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Product-owned commercial catalog. Intentionally configure every sellable plan.
# Shape: {"career":{"amountMinor":<integer>,"currency":"usd","interval":"month","intervalCount":1},"pro":{...},"concierge":{...}}
# No application-code fallback price exists; leaving this empty keeps checkout fail-closed.
HIRED_COMMERCIAL_CATALOG_JSON=

# Stripe is the collection rail. Price IDs must match the commercial catalog above.
# Never commit real values.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CAREER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_CONCIERGE=price_...

# Optional natural-language layer.
OPENAI_API_KEY=
HIRED_MAYA_MODEL=gpt-5.6-luna
HIRED_MAYA_MAX_OUTPUT_TOKENS=600

# Job discovery sources that you are authorized to consume.
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
JOB_JSON_FEEDS=

# Governed external connector adapters. JSON array of HTTPS endpoints.
# Example shape only — keep real bearer tokens in deployment secrets, not source control.
HIRED_CONNECTORS_JSON=[]

# Provider-neutral telemetry. The endpoint receives redacted JSON trace/metric envelopes.
HIRED_TELEMETRY_ENDPOINT=
HIRED_TELEMETRY_TOKEN=
HIRED_TELEMETRY_TIMEOUT_MS=3000
HIRED_TRACE_BUFFER_MAX=2000

# Runtime limits
HIRED_AUTH_RATE_LIMIT=12
HIRED_API_RATE_LIMIT=180
HIRED_DB_POOL_MAX=12
HIRED_CHECKPOINT_MS=5000
